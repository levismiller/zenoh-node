{
  "name": "zenoh-node",
  "version": "0.1.0",
  "description": "Native Node.js bindings for Zenoh — peer-to-peer pub/sub/query",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": ". $HOME/.cargo/env 2>/dev/null; cmake-js build",
    "rebuild": ". $HOME/.cargo/env 2>/dev/null; cmake-js rebuild",
    "install": ". $HOME/.cargo/env 2>/dev/null; cmake-js build",
    "clean": "cmake-js clean"
  },
  "dependencies": {
    "cmake-js": "^7.0.0",
    "node-addon-api": "^8.0.0"
  },
  "publishConfig": {
    "registry": "https://tools.fortemtech.com/artifactory/api/npm/npm-local/"
  }
}
